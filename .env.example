# Paystack — https://dashboard.paystack.com/#/settings/developer
# Use sk_test_… for testing, sk_live_… for production.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Monthly plan code (PLN_…). Create via Dashboard → Plans, or run:
#   npm run setup:paystack
PAYSTACK_PLAN_CODE=PLN_xxxxxxxx

# Optional. Defaults to PAYSTACK_SECRET_KEY (Paystack HMAC uses the secret key).
# PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxx

# Public site URL used as Paystack callback_url
# Local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (set in Hostinger env):
# NEXT_PUBLIC_SITE_URL=https://www.aifitnesscoach.co.za

# REQUIRED for /admin — admin is locked until this is set
ADMIN_SECRET=choose-a-long-random-string
