# === PRODUCTION (Hostinger) — use LIVE Paystack keys ===
# PAYSTACK_SECRET_KEY=sk_live_xxxxxxxx
# PAYSTACK_PLAN_CODE=PLN_xxxxxxxx
# NEXT_PUBLIC_SITE_URL=https://www.aifitnesscoach.co.za
# ADMIN_SECRET=long-random-string
# REGISTRY_DATA_PATH=/home/user/persistent/ai-fitness-data

# === LOCAL / TEST ===
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_PLAN_CODE=PLN_xxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Defaults to PAYSTACK_SECRET_KEY.
# PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxx

# REQUIRED for /admin
ADMIN_SECRET=choose-a-long-random-string

# Optional persistent folder for billing registry (survives deploys)
# REGISTRY_DATA_PATH=.data
